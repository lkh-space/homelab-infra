# ==============================================================================
# Homelab Infra - 통합 자격증명 관리 템플릿 (.credentials.local.example)
#
# 설명: 이 파일은 로컬 환경에서 변경된 각 인프라 서비스의 비밀번호를 기록하는 템플릿입니다.
#      실제 값은 .credentials.local 파일에 작성되며, Git 추적에서 영구 제외됩니다.
#
# 비밀번호 생성 규칙 권장:
#   - 길이: 16자 이상
#   - 문자 구성: 영문 대소문자(A-Z, a-z), 숫자(0-9), 특수문자(!@#$%^&*) 포함
# ==============================================================================

# 1. PostgreSQL (5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=P@ssw0rd!Secure9x#K
POSTGRES_DB=homelab_db

# 2. MongoDB (27017)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=M0ng0#Auth99!xQr$
MONGO_REPLICA_SET=rs0

# 3. Redis (6379)
REDIS_PASSWORD=R3d!s#Cache$88vKz!

# 4. RabbitMQ (AMQP: 5672, Management: 15672)
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=R@bb!t#Msg77$wQz!

# 5. MinIO (S3: 9000, Console: 9001)
# 주의: MinIO 비밀번호 변경 시 Loki도 함께 재기동해야 합니다.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=M!n!0#S3Storage99@xP

# 6. OpenSearch & Dashboards (REST: 9200, Dashboards: 5601)
OPENSEARCH_USERNAME=admin
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Op3n$earch!Admin88#K

# 7. Grafana (Web UI: 3000)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=Gr@fana!Obs88#vPz$

# 8. Authelia (SSO Gateway: 9091, auth.homelab.local)
AUTHELIA_ADMIN_USER=admin
AUTHELIA_ADMIN_EMAIL=admin@homelab.local
AUTHELIA_ADMIN_PASSWORD=Auth3l!a#Admin99@xP
AUTHELIA_JWT_SECRET=your_jwt_secret_at_least_64_characters_random_string_here_example
AUTHELIA_SESSION_SECRET=your_session_secret_at_least_64_characters_random_string_here
AUTHELIA_STORAGE_ENCRYPTION_KEY=your_storage_encryption_key_at_least_64_characters_random_string

