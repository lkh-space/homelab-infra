# ==============================================================================
# Runtime & Security
# ==============================================================================
NODE_ENV=production
PORT=3000
IS_LOCAL=false
LOG_LEVEL=info

# ==============================================================================
# Database (PostgreSQL / Shared Metadata)
# ==============================================================================
DATABASE_URL=postgresql://postgres:your_postgres_password@postgres-service.infra.svc.cluster.local:5432/homelab_db

# ==============================================================================
# Object Storage (MinIO)
# ==============================================================================
MINIO_ENDPOINT=http://minio-service.infra.svc.cluster.local:9000
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_DOCS=my-space-markdown
MINIO_BUCKET_ASSETS=my-space-assets
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true

# ==============================================================================
# Search Engine (OpenSearch)
# ==============================================================================
OPENSEARCH_NODE=https://opensearch-service.infra.svc.cluster.local:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your_opensearch_password
OPENSEARCH_REJECT_UNAUTHORIZED=false
OPENSEARCH_INDEX_DOCS=markdown-documents

# ==============================================================================
# Message Broker (RabbitMQ)
# ==============================================================================
RABBITMQ_URL=amqp://admin:your_rabbitmq_password@rabbitmq-service.infra.svc.cluster.local:5672
RABBITMQ_INDEXING_QUEUE=markdown-indexing-queue

# ==============================================================================
# Vector DB (Qdrant)
# ==============================================================================
QDRANT_URL=http://qdrant-service.infra.svc.cluster.local:6333
QDRANT_API_KEY=your_secure_qdrant_api_key
QDRANT_COLLECTION=personal-documents

# ==============================================================================
# Google Gemini (External LLM / Embedding Provider)
# ==============================================================================
GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
