apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: forward-auth-secret
  namespace: apps
  labels:
    app.kubernetes.io/name: forward-auth-secret
    app.kubernetes.io/part-of: homelab-apps
spec:
  headers:
    customRequestHeaders:
      x-forwarded-auth-secret: "your_auth_forwarded_secret_64hex"
